/{
/* The default uart console/shell is uart20, aka ttyACM1.
 * Set uart console/shell on ttyACM0 with selecting uart30. */
	chosen {
		zephyr,console = &uart30;
		zephyr,shell-uart = &uart30;
		zephyr,uart-mcumgr = &uart30;
	};
};

/*
spi21 pins assignement:
	spi21 Clock: P1.13, Button 0
	spi21 MOSI: P1.11
	spi21 MISO: P1.12
	spi21 CS: P2.08
QM35 pins assignement:
	QM35 IRQ: P0.04, Button 3
	QM35 Reset: P2.10
	QM35 EXTON: P1.08, Button 2
*/

&spi21 {
	status = "okay";
	pinctrl-0 = <&spi21_default>;
	pinctrl-1 = <&spi21_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio2 8 GPIO_ACTIVE_LOW>;
	qm35: hsspi@0 {
		compatible = "qorvo,hsspi";
		reg = < 0x0 >;
		spi-max-frequency = <5000000>;
		status = "okay";
		ss-irq-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio2 10 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;
		exton-gpios = <&gpio1 8 GPIO_ACTIVE_HIGH>;
	};
};

&pinctrl {
	spi21_default: spi21_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
				<NRF_PSEL(SPIM_MOSI, 1, 11)>,
				<NRF_PSEL(SPIM_MISO, 1, 12)>;
			nordic,drive-mode = <NRF_DRIVE_H0H1>;
		};
	};

	spi21_sleep: spi21_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
				<NRF_PSEL(SPIM_MOSI, 1, 11)>,
				<NRF_PSEL(SPIM_MISO, 1, 12)>;
			low-power-enable;
		};
	};
};

/* Enable uart30 for the console/shell. Configure it to 1Mbps. */
&uart30 {
	status = "okay";
	current-speed = <1000000>;
	hw-flow-control;
};

/* Disable uart20, used by the default for console/shell. */
&uart20 {
	status = "disabled";
};

/*
user_button gpio: Button 1, P1.09.
user_led gpio: LED 0, P2.09.
*/
/ {
	aliases {
		user-button = &user_button;
		user-led = &user_led;
	};
	leds {
		compatible = "gpio-leds";
		user_led: user_led {
			gpios = <&gpio2 9 GPIO_ACTIVE_HIGH>;
			label = "User LED";
		};
	};
	buttons {
		compatible = "gpio-keys";
		user_button: user_button {
			gpios = <&gpio1 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "User button";
		};
	};
};
