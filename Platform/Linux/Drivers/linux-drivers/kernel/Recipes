# Run with `make -f Recipes`.
#
# You can get help with `make -f Recipes help`.

ALL = linux/x86_64 linux/arm64 linux-uwb/dragon linux-rpi/pi4 linux-uwb/uwbkvm linux-uwb/um

CHROOT ?= uwb-stack-cross
DESTS = root@db845c

ifneq ($(CHROOT),)
arm64_SCHROOT = schroot -p -c $(CHROOT) --
dragon_SCHROOT = schroot -p -c $(CHROOT) --
pi4_SCHROOT = schroot -p -c $(CHROOT) --
endif

ifeq ($(COMPILER),llvm)
llvm_flags += CC=clang LLVM=1
endif
x86_64_compiler := $(llvm_flags)
arm64_compiler := ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- $(llvm_flags)

x86_64_CROSS := $(x86_64_compiler)

arm64_CROSS := $(arm64_compiler)

dragon_CROSS := $(arm64_compiler)
dragon_KARGS := CONFIG_QCOM_SPI_LOWLATENCY=m

pi4_CROSS := $(arm64_compiler)
pi4_INSTALLFLAGS := -D

uwbkvm_CROSS := $(x86_64_compiler)

um_CROSS := ARCH=um  $(x86_64_compiler)

DIR = $(word 1,$(subst ., ,$@))
HW = $(word 1,$(subst ., ,$(@F)))
TARGET = $(word 2,$(subst ., ,$@))

KDIR = ../projects/linux-build/$(DIR)/deps/linux/linux
KSRC = ../deps/linux/$(dir $(DIR))

CROSS = $($(HW)_CROSS)
SCHROOT = $($(HW)_SCHROOT)

gen_compdb = $(KSRC)scripts/clang-tools/gen_compile_commands.py

# Kernel CONFIG_xxx parameters
MODULES := QM35 QM35_HWSIM
CCFLAGS := KUNIT_TESTS QM35_FLASHING QM35_PROBING
define config
	$(foreach c,$(patsubst %,CONFIG_%,$1),$(if $($c),$c=$($c),$c=m)) \
	$(foreach c,$(patsubst %,CONFIG_%,$2),$(if $($c),$c=$($c),$c=y))
endef

KARGS = $(CROSS) $(call config,$(MODULES),$(CCFLAGS)) $($(HW)_KARGS)

all: $(ALL:%=%.all)
	@:
clean: $(ALL:%=%.clean)
	@:
compdb: $(ALL:%=%.compdb)
	@:

%.all %.modules_install %.bindeb-pkg:
	$(SCHROOT) $(MAKE) -f Makefile KDIR=$(KDIR) $(KARGS) $(TARGET)

%.clean:
	$(SCHROOT) $(MAKE) -f Makefile KDIR=$(KDIR) $(KARGS) clean
	find $(KDIR)/../../.. -name *.gcda -exec rm {} \;

%.install: %.all
	../tools/ssh-kernel-install --args '-f Makefile KDIR=$(KDIR) $(KARGS)' --external-modules . $($*_INSTALLFLAGS) $(DESTS)

%.compdb: %.all
	$(gen_compdb) -d $(KDIR) $(KDIR)/../../../kernel

%.test: %.all
	$(MAKE) -f Makefile KDIR=$(KDIR) $(KARGS) tests

%.cov: export CONFIG_COVERAGE=y
%.cov: %.all
	$(MAKE) -f Makefile KDIR=$(KDIR) $(KARGS) cov

test: linux/um.test

cov: linux/um.cov

check: check_format check_doc

check_format:
	../tools/check-format include drivers

check_doc:
	../deps/linux/linux/scripts/kernel-doc -Werror -none $$(git ls-files '**.[ch]' | \
	grep -v -e 'drivers/spi/spi-geni-qcom-lowlatency.c' -e 'libqmrom/' -e 'libfwupdater/')

help:
	@echo "For all configured kernels ($(ALL))"
	@echo "  all      - build external modules, need a prepared kernel tree"
	@echo "  clean    - remove generated files"
	@echo "  test     - run unit test suites"
	@echo "  cov      - run coverage on unit test suites"
	@echo ""
	@echo "For a specific kernel (for example $(firstword $(ALL)))"
	@echo "  %.all        - same as all, but for one kernel"
	@echo "  %.clean      - same as clean, but for one kernel"
	@echo "  %.install    - install specific kernel using ssh-kernel-install"
	@echo "                 override destinations using DESTS='root@a root@b'"
	@echo "  %.bindeb-pkg - build debian packages allowing easy install"
	@echo ""
	@echo "Generic commands"
	@echo "  check_format - run clang-format"
	@echo "  check_doc    - check kernel-doc comments"
	@echo "  check        - run all checks"
	@echo ""
	@echo "Example:"
	@echo "  export CHROOT=linaro"
	@echo "  make -C ../projects/linux-build linux-uwb/dragon.all"
	@echo "  make -C ../projects/linux-build linux-uwb/dragon.all COMPILER=llvm - Build with Clang/LLVM"
	@echo "  make -C ../projects/linux-build linux-uwb/dragon.bindeb-pkg"
	@echo "  make -f Recipes linux-uwb/dragon.bindeb-pkg"
