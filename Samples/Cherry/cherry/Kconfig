menuconfig CHERRY
	bool "Cherry lib"
	default y
	help
	  Enable Cherry lib

config CHERRY_ZEPHYR
	bool "Use Cherry lib for Zephyr"
	default n
	depends on CHERRY
	select QOSAL_IMPL_ZEPHYR
	select UCI_ZEPHYR
	help
	  This option sets the build of Cherry lib for Zephyr.
