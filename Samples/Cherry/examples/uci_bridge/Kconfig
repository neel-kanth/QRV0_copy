menuconfig CHERRY_BRIDGE
	bool "Cherry bridge"
	default y
	help
	  Enable Cherry examples

config CHERRY_BRIDGE_ZEPHYR
	bool "Build Cherry bridge for Zephyr"
	default n
	depends on CHERRY_BRIDGE
	help
	  This option sets the build of Cherry bridge for Zephyr.
