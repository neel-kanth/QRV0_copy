[Unit]
Description=UCI bridge listening on serial port
Requires=dev-uci0.device
After=dev-uci0.device network.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
EnvironmentFile=/etc/default/uci-bridge
ExecStart=/usr/bin/uci-bridge -d /dev/uci0 -p $SERIAL_PORT -l $LOG_LEVEL $EXTRA_OPTS
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
