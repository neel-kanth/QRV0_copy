menuconfig QMUTILS
	bool "Use qm-utils library"
	default y
	help
	  Enable qm-utils library

config QMUTILS_ZEPHYR
	bool "Use qm-utils library for Zephyr"
	default n
	depends on QMUTILS
	help
	  This option sets the build of qm-utils library for Zephyr.
