menuconfig QOSAL
	bool "QOSAL lib"
	default y
	help
	  Enable qosal

config QOSAL_IMPL_ZEPHYR
	bool "Use QOSAL lib for Zephyr"
	default n
	depends on QOSAL
	help
	  This option sets the build of QOSAL lib for Zephyr.

config QOSAL_MAX_MUTEX
	int "Max number of supported mutexes"
	default 5
	help
	  Max number of supported mutexes

config QLOG_LEVEL
	int "Selected QLOG default level"
	default 4
	help
	  Default level for QLOG()
